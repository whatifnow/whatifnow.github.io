---
const formats = [
  {
    initial: "B",
    duration: "90 min — half day",
    title: "Briefing",
    description: "A plain-English session for a leadership team or board. What AI can do for an organisation your size — and what it can't.",
    featured: false
  },
  {
    initial: "W",
    duration: "1–2 days · on-site or remote",
    title: "Workshop",
    description: "Theory in the morning, hands-on labs in the afternoon. Your team leaves having actually built something — a custom GPT, a triage flow, an inventory.",
    featured: true,
    pop: "MOST BOOKED"
  },
  {
    initial: "P",
    duration: "Fractional · sprint or retainer",
    title: "Pairing",
    description: "One or two days a week beside one of yours, on the task they're stuck on — strategy, governance, ops. Sprint-bounded for a defined push, or rolling as ongoing fractional AI officer cover.",
    featured: false
  },
  {
    initial: "B",
    duration: "4–10 weeks · fixed fee",
    title: "Build",
    description: "We design, build, and ship a working AI tool tailored to your operation. Fixed scope, fixed fee. We document, train, and step out. Commercial fit — bespoke or product-based — agreed in scoping.",
    featured: false
  }
];
---

<section id="services" class="py-20 px-6 bg-navy">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="inline-block text-teal font-ui font-bold text-xs tracking-widest uppercase mb-4">Want this for your team?</span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white font-serif">
        Pick the engagement that fits.
      </h2>
      <p class="text-slate-light text-lg mb-3 max-w-2xl mx-auto">
        Four formats. Scope and fit agreed on the call.
      </p>
      <p class="text-slate-light text-sm max-w-3xl mx-auto opacity-90">
        Inside any engagement we typically deliver some combination of AI strategy, custom automation builds, fractional AI officer cover, and team training.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 items-stretch">
      {formats.map((fmt) => (
        <div class={`relative p-6 rounded-2xl flex flex-col gap-2 ${
          fmt.featured
            ? 'bg-white text-navy border-2 border-amber'
            : 'bg-navy-light border border-white/10'
        }`}>
          {fmt.featured && fmt.pop && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-amber text-charcoal font-ui font-bold text-[11px] tracking-widest uppercase px-3 py-1 rounded-full whitespace-nowrap">
              {fmt.pop}
            </span>
          )}
          <div class={`w-9 h-9 rounded-lg flex items-center justify-center font-serif text-lg ${
            fmt.featured ? 'bg-amber/15 text-amber-dark' : 'bg-teal/15 text-teal'
          }`}>
            {fmt.initial}
          </div>
          <div class={`text-xs font-ui tracking-wider uppercase mt-1 font-bold ${
            fmt.featured ? 'text-amber-dark' : 'text-teal'
          }`}>
            {fmt.duration}
          </div>
          <h3 class={`text-xl font-bold font-serif ${
            fmt.featured ? 'text-navy' : 'text-white'
          }`}>
            {fmt.title}
          </h3>
          <p class={`text-sm leading-relaxed ${
            fmt.featured ? 'text-slate' : 'text-slate-light'
          }`}>
            {fmt.description}
          </p>
        </div>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-teal text-navy font-ui font-bold px-8 py-3.5 rounded-full hover:bg-teal-dark hover:text-white transition-colors"
      >
        Let's Chat
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
