          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-navy-light pt-6 flex flex-col md:flex-row items-center justify-between gap-3 text-slate-light/80 text-sm text-center md:text-left">
      <p>&copy; {currentYear} What If Now Ltd · Registered in Dublin, Ireland</p>
      <p>Data controller: <a href="mailto:privacy@whatifnow.ie" class="hover:text-white transition-colors">privacy@whatifnow.ie</a></p>
    </div>
  </div>
</footer>
