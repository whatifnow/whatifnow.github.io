---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy border-t border-navy-light px-6 pt-14 pb-8">
  <div class="max-w-6xl mx-auto">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1.2fr] mb-12">
      <!-- Brand -->
      <div>
        <a href="/" class="text-2xl font-bold tracking-tight">
          <span class="text-white">what </span><span class="text-teal">if</span><span class="text-white"> now</span>
        </a>
        <p class="text-slate-light text-sm mt-4 leading-relaxed max-w-xs">
          Practical AI for teams figuring out where it fits. We build working tools, not slideware.
        </p>
        <p class="text-slate-light text-sm mt-3">Built in Dublin, Ireland.</p>
      </div>

      <!-- Products -->
      <div>
        <h3 class="text-white font-ui font-bold text-xs tracking-widest uppercase mb-4">Products</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="https://www.righttostay.ie" target="_blank" rel="noopener noreferrer" class="text-slate-light hover:text-white transition-colors">Right To Stay</a></li>
          <li><a href="/solutions#stare" class="text-slate-light hover:text-white transition-colors">Stare</a></li>
          <li><a href="/solutions#replypack" class="text-slate-light hover:text-white transition-colors">ReplyPack</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-white font-ui font-bold text-xs tracking-widest uppercase mb-4">Company</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/solutions" class="text-slate-light hover:text-white transition-colors">Solutions</a></li>
          <li><a href="/#about" class="text-slate-light hover:text-white transition-colors">About</a></li>
          <li><a href="/#compliance" class="text-slate-light hover:text-white transition-colors">Compliance</a></li>
          <li><a href="/ai-readiness" class="text-slate-light hover:text-white transition-colors">AI Readiness Assessment</a></li>
          <li><a href="/contact" class="text-slate-light hover:text-white transition-colors">Contact</a></li>
          <li><a href="/privacy" class="text-slate-light hover:text-white transition-colors">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Get in touch -->
      <div>
        <h3 class="text-white font-ui font-bold text-xs tracking-widest uppercase mb-4">Get in touch</h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="mailto:paul@whatifnow.ie" class="text-slate-light hover:text-white transition-colors inline-flex items-center gap-2">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              paul@whatifnow.ie
            </a>
          </li>
          <li>
            <a href="tel:+353864107710" class="text-slate-light hover:text-white transition-colors inline-flex items-center gap-2 whitespace-nowrap">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
