<section class="min-h-screen flex items-center pt-20 pb-16 px-6">
  <div class="max-w-6xl mx-auto w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Copy column -->
      <div class="space-y-8">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-white font-serif">
          Practical AI for teams figuring out <span class="text-teal whitespace-nowrap">where it fits</span>.
        </h1>

        <p class="text-xl md:text-2xl text-slate-light leading-relaxed">
          We're an AI Product and Services Company. We find the manual, repetitive work eating your team's time, and build tools to handle it.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/ai-readiness"
            class="bg-teal text-navy font-ui px-8 py-4 rounded-full font-bold text-lg hover:bg-teal-dark hover:text-white transition-colors text-center"
          >
            Find out if your business is AI-Ready
          </a>
          <a
            href="https://calendly.com/paul-whatifnow"
            target="_blank"
            rel="noopener noreferrer"
            class="border-2 border-slate-light text-white font-ui px-8 py-4 rounded-full font-bold text-lg hover:bg-navy-light transition-colors text-center"
          >
            Schedule a chat with Paul
          </a>
        </div>
      </div>

      <!-- AI Readiness Audit preview: video on desktop (src set via script so
           phones never download the 5.5MB file), still frame on smaller screens -->
      <div>
        <video
          id="hero-audit-video"
          class="hidden lg:block w-full aspect-video object-cover rounded-2xl shadow-2xl border border-slate/10"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          aria-label="Preview of the What If Now AI Readiness Audit"
        ></video>
        <img
          src="/images/hero-audit-still.jpg"
          alt="The AI Readiness Audit — 18 questions, 3 minutes, free"
          width="1920"
          height="1080"
          class="lg:hidden w-full aspect-video object-cover rounded-2xl shadow-2xl border border-slate/10"
        />
      </div>
      <script is:inline>
        (function () {
          var v = document.getElementById('hero-audit-video');
          if (v && window.matchMedia('(min-width: 1024px)').matches) {
            v.src = '/videos/ai-readiness-audit.mp4';
            var p = v.play();
            if (p && p.catch) p.catch(function () {});
          }
        })();
      </script>
    </div>
  </div>
</section>
