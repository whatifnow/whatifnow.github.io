      <td>${r.owner!=="—"?`<span class="own">${r.owner}</span>`:`<span style="color:var(--line-strong)">—</span>`}</td>
      <td class="note-cell" contenteditable="true" spellcheck="false"
          onclick="event.stopPropagation()"
          onblur="toast('Note saved — synced to the grant record (mock)')">${r.notes}</td>
    </tr>`).join("");
}

function setBFilter(k){ state.bfilter=k; renderBChips(); renderBible(); }
function bibleRow(id){
  const r = BIBLE.find(x=>x.id===id);
  if(r.link==="grants"){ showPage("grants"); toast("Opening Community Resilience Fund 2026 — matching run #3"); }
  else toast("Mockup — full grant record: history, documents, linked runs and communications");
}

const PAGES = {grants:["page-grants","flex"], bible:["page-bible","block"], dash:["page-dash","block"], clients:["page-clients","block"], reports:["page-reports","block"]};
const NAVS = {grants:"nav-grants", bible:"nav-bible", dash:"nav-dash", clients:"nav-clients", reports:"nav-reports"};
function showPage(p){
  for(const k in PAGES) document.getElementById(PAGES[k][0]).style.display = (k===p ? PAGES[k][1] : "none");
  for(const k in NAVS) document.getElementById(NAVS[k]).classList.toggle("active", k===p);
}

document.getElementById("bsearch").addEventListener("input", e=>{ state.bq=e.target.value.toLowerCase(); renderBible(); });

renderBChips(); renderBible();
