const TIER = {
  eligible:{label:"Eligible", cls:"b-eligible"},
  gaps:{label:"Has gaps", cls:"b-gaps"},
  lateral:{label:"Lateral suggestion", cls:"b-lateral"},
  inelig:{label:"Not eligible", cls:"b-inelig"}
};
const VERDICT = {met:{l:"Met",c:"v-met",i:"✓"}, gap:{l:"Gap",c:"v-gap",i:"!"}, unclear:{l:"Unclear",c:"v-unclear",i:"?"}, fail:{l:"Not met",c:"v-fail",i:"✕"}};

let state = {sel:1, filter:"all", q:"", tab:"assess"};

function toast(msg){
  const t = document.getElementById("toast");
  t.textContent = msg; t.classList.add("show");
  clearTimeout(t._h); t._h = setTimeout(()=>t.classList.remove("show"), 2600);
}

function chipDefs(){
  const n = t => MATCHES.filter(m=>m.tier===t).length;
  return [
    {k:"all", label:"All " + MATCHES.length},
    {k:"eligible", label:"Eligible " + n("eligible")},
    {k:"gaps", label:"Gaps " + n("gaps")},
    {k:"lateral", label:"Lateral " + n("lateral")},
    {k:"decided", label:"Decided " + MATCHES.filter(m=>m.status!=="pending").length}
  ];
}

function renderChips(){
  document.getElementById("chips").innerHTML = chipDefs().map(c =>
    `<button class="chip ${state.filter===c.k?"active":""}" onclick="setFilter('${c.k}')">${c.label}</button>`).join("");
}

function visible(){
  return MATCHES.filter(m=>{
    if(state.filter==="decided" && m.status==="pending") return false;
    if(["eligible","gaps","lateral"].includes(state.filter) && m.tier!==state.filter) return false;
    if(state.q && !(m.client+" "+m.project).toLowerCase().includes(state.q)) return false;
    return true;
  });
}

function statusBadge(m){
  if(m.status==="approved") return `<span class="badge b-approved">Approved</span>`;
  if(m.status==="rejected") return `<span class="badge b-rejected">Rejected</span>`;
  return "";
}

function renderList(){
  const list = visible();
  document.getElementById("mlist").innerHTML = list.length ? list.map(m => `
    <div class="mcard ${m.id===state.sel?"sel":""}" onclick="select(${m.id})">
      <div class="row1"><span class="client">${m.client}</span><span class="score">${m.score}</span></div>
      <div class="proj">${m.project}</div>
      <div class="scorebar"><i style="width:${m.score}%"></i></div>
      <div class="badges">
        <span class="badge ${TIER[m.tier].cls}">${TIER[m.tier].label}</span>
        <span class="badge b-conf">${m.conf} confidence</span>
        ${statusBadge(m)}
      </div>
    </div>`).join("") : `<div style="color:var(--faint);font-size:13px;text-align:center;padding:30px 10px">No matches for this filter.</div>`;
}

function critRows(m){
  return m.criteria.map(cr => {
    const v = VERDICT[cr.v];
    return `<tr>
      <td style="width:34%;font-weight:550">${cr.c}</td>
      <td style="width:14%"><span class="verdict ${v.c}"><span class="v-ico">${v.i}</span>${v.l}</span></td>
      <td class="evidence">${cr.e}${cr.s && cr.s!=="—" ? `<br><span class="cite" onclick="event.stopPropagation();toast('Mockup — would open: ${cr.s.replace(/'/g,"")}')">⌕ ${cr.s}</span>`:""}</td>
    </tr>`;
  }).join("");
}

function renderDetail(){
  const m = MATCHES.find(x=>x.id===state.sel);
  if(!m){ document.getElementById("detail").innerHTML=""; return; }
  const auditRows = [...RUN_AUDIT, m.ma].map(a =>
    `<li><time>${a.t}</time><div class="a-body">${a.b}<div class="a-meta">${a.m}</div></div></li>`).join("");
  const assess = `
    <div class="card">
      <h4>Criterion assessment <span class="count">${m.criteria.length} criteria · every claim cited to a source</span></h4>
      <table><thead><tr><th>Criterion</th><th>Verdict</th><th>Evidence</th></tr></thead><tbody>${critRows(m)}</tbody></table>
    </div>
    ${m.missing.length ? `<div class="card"><h4>Missing before submission <span class="count">${m.missing.length}</span></h4><ul class="missing">${m.missing.map(x=>`<li>${x}</li>`).join("")}</ul></div>`:""}`;
  const audit = `
    <div class="card">
      <h4>Decision audit trail <span class="count">run #3 · 24 Jul 2026 · fully replayable</span></h4>
      <ul class="audit">${auditRows}
        <li><time>—</time><div class="a-body">All steps stored with full inputs, outputs, model and prompt versions. Nothing reaches a client without human approval.<div class="a-meta">retention: 24 months · EU region</div></div></li>
      </ul>
    </div>`;
  document.getElementById("detail").innerHTML = `
    <div class="d-head">
      <div class="d-top">
        <div class="d-title">
          <h3>${m.client}</h3>
          <div class="sub">${m.project} · Community Resilience Fund 2026</div>
          <div class="d-badges">
            <span class="badge ${TIER[m.tier].cls}">${TIER[m.tier].label}</span>
            <span class="badge b-conf">${m.conf} confidence</span>
            ${statusBadge(m)}
          </div>
        </div>
        <div class="scorering"><div class="ring" style="--p:${m.score}"><span>${m.score}</span></div><div class="lbl">Fit score</div></div>
      </div>
      ${m.lateralNote ? `<div class="lateral-note"><span>◈</span><div><b>Machine-suggested opportunity.</b> ${m.lateralNote}</div></div>`:""}
      <div class="d-summary">${m.summary}</div>
    </div>
    <div class="tabs">
      <div class="tab ${state.tab==="assess"?"active":""}" onclick="setTab('assess')">Assessment</div>
      <div class="tab ${state.tab==="audit"?"active":""}" onclick="setTab('audit')">Audit trail</div>
    </div>
    ${state.tab==="assess" ? assess : audit}
    <div class="actionbar">
      <button class="btn btn-approve" onclick="decide(${m.id},'approved')">Approve for drafting</button>
      <button class="btn" onclick="toast('Mockup — would generate a client-ready Word synopsis into the Teams folder')">Export Word synopsis</button>
      <button class="btn" onclick="toast('Mockup — would open a templated info request to the client')">Request missing info</button>
      <button class="btn btn-reject" onclick="decide(${m.id},'rejected')">Reject</button>
      <span class="action-note">Decisions are logged to the audit trail${m.status!=="pending" ? " · currently <b>&nbsp;"+m.status+"</b>":""}</span>
    </div>`;
}

function select(id){ state.sel=id; state.tab="assess"; renderList(); renderDetail(); }
function setFilter(k){ state.filter=k; renderChips(); renderList(); }
function setTab(t){ state.tab=t; renderDetail(); }
function decide(id, s){
  const m = MATCHES.find(x=>x.id===id);
  m.status = (m.status===s) ? "pending" : s;
  renderList(); renderChips(); renderDetail();
  toast(m.status==="pending" ? "Decision cleared — logged to audit trail" : (s==="approved" ? m.client+" approved for drafting — logged to audit trail" : m.client+" rejected — logged to audit trail"));
}
document.getElementById("search").addEventListener("input", e=>{ state.q=e.target.value.toLowerCase(); renderList(); });

renderChips(); renderList(); renderDetail();

