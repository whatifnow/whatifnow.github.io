<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grant Matching Workspace — Yellow Harbour</title>
<meta name="robots" content="noindex, nofollow">
<style is:global>
  :root{
    --bg:#F2F5F7; --surface:#FFFFFF; --ink:#17242F; --muted:#5C6B7A; --faint:#8A97A5;
    --line:#E2E8EE; --line-strong:#C9D3DC;
    --brand:#0E6E68; --brand-soft:#E0F2F0; --brand-ink:#0A4B47;
    --gold:#F5B82E; --gold-soft:#FDF3DC;
    --green:#1E8E5F; --green-soft:#E2F4EA;
    --amber:#A96F10; --amber-soft:#FBEFD8;
    --purple:#6252C6; --purple-soft:#ECE9FA;
    --red:#C4453C; --red-soft:#FAE6E4;
    --radius:10px;
    font-size:14px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--ink);height:100vh;display:flex;flex-direction:column;overflow:hidden}

  /* ── Top bar ─────────────────────────── */
  header{height:54px;background:#0F3A43;color:#fff;display:flex;align-items:center;gap:28px;padding:0 20px;flex-shrink:0}
  .logo{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:.2px}
  .logo-mark{width:26px;height:26px;border-radius:6px;background:var(--gold);display:flex;align-items:center;justify-content:center}
  .logo-mark svg{display:block}
  nav{display:flex;gap:4px;font-size:13px}
  nav a{color:#B8CCD2;text-decoration:none;padding:6px 12px;border-radius:6px}
  nav a.active{background:rgba(255,255,255,.14);color:#fff;font-weight:600}
  nav a:hover{color:#fff}
  .top-right{margin-left:auto;display:flex;align-items:center;gap:14px;font-size:13px}
  .env-chip{background:rgba(245,184,46,.18);border:1px solid rgba(245,184,46,.5);color:var(--gold);padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600}
  .avatar{width:30px;height:30px;border-radius:50%;background:var(--brand);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700}

  /* ── Breadcrumb / run bar ────────────── */
  .runbar{background:var(--surface);border-bottom:1px solid var(--line);padding:10px 20px;display:flex;align-items:center;gap:18px;flex-shrink:0}
  .crumbs{font-size:13px;color:var(--muted)}
  .crumbs b{color:var(--ink);font-weight:600}
  .crumbs span{margin:0 6px;color:var(--line-strong)}
  .runmeta{margin-left:auto;display:flex;gap:16px;font-size:12px;color:var(--muted);align-items:center}
  .runmeta .dot{width:4px;height:4px;border-radius:50%;background:var(--line-strong)}
  .runmeta code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;background:var(--bg);padding:2px 6px;border-radius:4px;color:var(--muted)}

  /* ── Layout ──────────────────────────── */
  .workspace{flex:1;display:grid;grid-template-columns:272px 372px 1fr;gap:0;min-height:0}

  /* ── Grant panel ─────────────────────── */
  .grant-panel{background:var(--surface);border-right:1px solid var(--line);overflow-y:auto;padding:18px 16px}
  .grant-panel h2{font-size:15px;line-height:1.35;margin-bottom:2px}
  .funder{font-size:12.5px;color:var(--muted);margin-bottom:14px}
  .grant-facts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px}
  .fact{background:var(--bg);border-radius:8px;padding:8px 10px}
  .fact .k{font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;color:var(--faint);margin-bottom:2px}
  .fact .v{font-size:13px;font-weight:600}
  .panel-h{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--faint);margin:16px 0 8px;font-weight:700}
  .crit-list{list-style:none;display:flex;flex-direction:column;gap:6px}
  .crit-list li{font-size:12.5px;color:var(--ink);display:flex;gap:8px;align-items:flex-start;line-height:1.4}
  .crit-list li::before{content:"";width:6px;height:6px;border-radius:2px;background:var(--brand);margin-top:5px;flex-shrink:0}
  .src{display:flex;align-items:center;gap:8px;font-size:12.5px;padding:7px 9px;border:1px solid var(--line);border-radius:8px;margin-bottom:6px;color:var(--ink);cursor:pointer}
  .src:hover{border-color:var(--brand);background:var(--brand-soft)}
  .src .ico{width:22px;height:22px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0}
  .ico-pdf{background:var(--red-soft);color:var(--red)}
  .ico-web{background:var(--brand-soft);color:var(--brand)}
  .ico-doc{background:#E3EDFB;color:#2563A8}
  .src small{display:block;color:var(--faint);font-size:11px}

  /* ── Match list ──────────────────────── */
  .match-col{display:flex;flex-direction:column;min-height:0;border-right:1px solid var(--line)}
  .match-tools{padding:12px 14px 8px;background:var(--surface);border-bottom:1px solid var(--line)}
  .search{width:100%;padding:7px 10px;border:1px solid var(--line-strong);border-radius:8px;font-size:13px;margin-bottom:10px;background:var(--bg)}
  .search:focus{outline:2px solid var(--brand-soft);border-color:var(--brand)}
  .chips{display:flex;gap:6px;flex-wrap:wrap}
  .chip{border:1px solid var(--line-strong);background:var(--surface);border-radius:999px;padding:4px 11px;font-size:12px;cursor:pointer;color:var(--muted)}
  .chip.active{background:#0F3A43;color:#fff;border-color:#0F3A43;font-weight:600}
  .match-list{overflow-y:auto;flex:1;padding:10px 12px;display:flex;flex-direction:column;gap:8px}
  .mcard{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:11px 12px;cursor:pointer;position:relative}
  .mcard:hover{border-color:var(--line-strong);box-shadow:0 1px 4px rgba(23,36,47,.06)}
  .mcard.sel{border-color:var(--brand);box-shadow:0 0 0 1px var(--brand)}
  .mcard .row1{display:flex;align-items:baseline;gap:8px}
  .mcard .client{font-weight:650;font-size:13.5px}
  .mcard .score{margin-left:auto;font-weight:700;font-size:14px}
  .mcard .proj{font-size:12.5px;color:var(--muted);margin:2px 0 8px;line-height:1.35}
  .scorebar{height:4px;border-radius:2px;background:var(--bg);margin-bottom:8px;overflow:hidden}
  .scorebar i{display:block;height:100%;border-radius:2px;background:var(--brand)}
  .badges{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
  .badge{font-size:10.5px;font-weight:650;padding:2.5px 8px;border-radius:999px;letter-spacing:.2px}
  .b-eligible{background:var(--green-soft);color:var(--green)}
  .b-gaps{background:var(--amber-soft);color:var(--amber)}
  .b-lateral{background:var(--purple-soft);color:var(--purple)}
  .b-inelig{background:var(--red-soft);color:var(--red)}
  .b-approved{background:var(--green);color:#fff}
  .b-rejected{background:var(--red);color:#fff}
  .b-conf{background:var(--bg);color:var(--muted)}

  /* ── Detail pane ─────────────────────── */
  .detail{overflow-y:auto;min-height:0;padding:18px 22px 90px;position:relative}
  .d-head{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:14px}
  .d-top{display:flex;align-items:flex-start;gap:16px}
  .d-title h3{font-size:17px;margin-bottom:2px}
  .d-title .sub{color:var(--muted);font-size:13px}
  .scorering{margin-left:auto;text-align:center;flex-shrink:0}
  .ring{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;background:conic-gradient(var(--brand) calc(var(--p)*1%), var(--line) 0);position:relative}
  .ring::before{content:"";position:absolute;inset:6px;border-radius:50%;background:var(--surface)}
  .ring span{position:relative}
  .scorering .lbl{font-size:10.5px;color:var(--faint);margin-top:4px;text-transform:uppercase;letter-spacing:.5px}
  .d-badges{display:flex;gap:6px;margin-top:10px;flex-wrap:wrap}
  .d-summary{margin-top:12px;padding-top:12px;border-top:1px solid var(--line);font-size:13.5px;line-height:1.55;color:var(--ink)}
  .lateral-note{margin-top:10px;background:var(--purple-soft);border:1px solid #D8D2F2;border-radius:8px;padding:10px 12px;font-size:12.5px;color:#463A96;line-height:1.5;display:flex;gap:8px}
  .tabs{display:flex;gap:2px;margin:16px 0 12px;border-bottom:1px solid var(--line)}
  .tab{padding:8px 14px;font-size:13px;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
  .tab.active{color:var(--brand-ink);border-color:var(--brand);font-weight:650}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-bottom:14px}
  .card h4{font-size:13px;padding:12px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px}
  .card h4 .count{font-size:11px;color:var(--muted);font-weight:500}
  table{width:100%;border-collapse:collapse;font-size:13px}
  th{font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;color:var(--faint);text-align:left;padding:8px 16px;border-bottom:1px solid var(--line);background:#FAFBFC}
  td{padding:10px 16px;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.45}
  tr:last-child td{border-bottom:none}
  .verdict{display:inline-flex;align-items:center;gap:6px;font-weight:650;font-size:12px;white-space:nowrap}
  .v-met{color:var(--green)} .v-gap{color:var(--amber)} .v-unclear{color:var(--faint)} .v-fail{color:var(--red)}
  .v-ico{width:16px;height:16px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:10px;color:#fff;flex-shrink:0}
  .v-met .v-ico{background:var(--green)} .v-gap .v-ico{background:var(--amber)} .v-unclear .v-ico{background:var(--faint)} .v-fail .v-ico{background:var(--red)}
  .evidence{color:var(--ink)}
  .cite{display:inline-block;background:var(--bg);border:1px solid var(--line);border-radius:5px;padding:1px 7px;font-size:11px;color:var(--muted);margin-top:5px;cursor:pointer}
  .cite:hover{border-color:var(--brand);color:var(--brand-ink)}
  .missing{padding:12px 16px}
  .missing li{margin-left:18px;font-size:13px;line-height:1.7;color:var(--ink)}
  .audit{list-style:none}
  .audit li{display:flex;gap:12px;padding:10px 16px;border-bottom:1px solid var(--line);font-size:12.5px}
  .audit li:last-child{border-bottom:none}
  .audit time{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;color:var(--faint);white-space:nowrap;padding-top:1px}
  .audit .a-body b{font-weight:650}
  .audit .a-meta{color:var(--faint);font-size:11px;margin-top:2px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}

  /* ── Action bar ──────────────────────── */
  .actionbar{position:absolute;bottom:0;left:0;right:0;background:var(--surface);border-top:1px solid var(--line);padding:12px 22px;display:flex;gap:10px;align-items:center}
  .btn{border:1px solid var(--line-strong);background:var(--surface);border-radius:8px;padding:9px 16px;font-size:13px;font-weight:600;cursor:pointer;color:var(--ink)}
  .btn:hover{border-color:var(--brand)}
  .btn-approve{background:var(--brand);border-color:var(--brand);color:#fff}
  .btn-approve:hover{background:var(--brand-ink)}
  .btn-reject{color:var(--red)}
  .btn-reject:hover{border-color:var(--red);background:var(--red-soft)}
  .action-note{margin-left:auto;font-size:12px;color:var(--faint)}

  /* ── Grant Bible ─────────────────────── */
  #page-grants{flex:1;display:flex;flex-direction:column;min-height:0}
  #page-bible{flex:1;overflow-y:auto;min-height:0;padding:20px 24px 60px}
  .bible-head{display:flex;align-items:flex-end;gap:16px;margin-bottom:16px}
  .bible-head h1{font-size:20px}
  .bible-head .sub{font-size:12.5px;color:var(--muted);margin-top:3px}
  .bible-head .sub b{color:var(--brand-ink)}
  .bible-head .btn{margin-left:auto}
  .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}
  .kpi{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
  .kpi .n{font-size:20px;font-weight:750}
  .kpi .k{font-size:11px;color:var(--faint);text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
  .kpi .s{font-size:11px;color:var(--muted);margin-top:4px}
  .mstrip{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;margin-bottom:6px}
  .mcardlet{flex:0 0 auto;background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--brand);border-radius:8px;padding:8px 12px;font-size:12px;min-width:240px}
  .mcardlet.hot{border-left-color:var(--red)}
  .mcardlet.warn{border-left-color:var(--gold)}
  .mcardlet b{display:block;font-size:12.5px;margin-bottom:1px}
  .mcardlet span{color:var(--muted)}
  .mnote{font-size:11px;color:var(--faint);margin:0 0 16px}
  .btoolbar{display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap}
  .btoolbar .search{width:250px;margin:0}
  .btoolbar .auto-note{margin-left:auto;font-size:11.5px;color:var(--brand-ink)}
  .stagechip{font-size:10.5px;font-weight:650;padding:3px 9px;border-radius:999px;white-space:nowrap}
  .st-intake{background:#EEF1F4;color:#5C6B7A}
  .st-matching{background:var(--brand-soft);color:var(--brand-ink)}
  .st-qualified{background:#E3EDFB;color:#2563A8}
  .st-drafting{background:var(--gold-soft);color:#8A6206}
  .st-clientreview{background:var(--amber-soft);color:var(--amber)}
  .st-submitted{background:var(--purple-soft);color:var(--purple)}
  .st-awarded{background:var(--green-soft);color:var(--green)}
  .st-declined{background:var(--red-soft);color:var(--red)}
  .stagenote{font-size:11.5px;color:var(--muted);margin-top:4px;line-height:1.35;max-width:240px}
  .stagenote.warn{color:var(--amber);font-weight:600}
  .fundcell b{font-size:13.5px}
  .fundcell .funder{font-size:11.5px;color:var(--muted);margin-top:1px}
  .recur{font-size:11px;color:var(--purple);margin-top:4px}
  .autochip{display:inline-flex;align-items:center;gap:3px;font-size:9.5px;font-weight:700;background:var(--brand-soft);color:var(--brand-ink);border-radius:4px;padding:1px 5px;vertical-align:2px;margin-left:6px;letter-spacing:.3px}
  .countd{display:inline-block;font-size:10.5px;font-weight:650;border-radius:5px;padding:1px 7px;margin-left:6px;background:#EEF1F4;color:#5C6B7A}
  .countd.warn{background:var(--amber-soft);color:var(--amber)}
  .countd.hot{background:var(--red-soft);color:var(--red)}
  .mssub{font-size:11px;color:var(--faint);margin-top:3px}
  .reqbar{width:70px;height:4px;border-radius:2px;background:var(--bg);margin-top:5px;overflow:hidden}
  .reqbar i{display:block;height:100%;background:var(--green)}
  .own{width:24px;height:24px;border-radius:50%;background:#0F3A43;color:#fff;font-size:10px;font-weight:700;display:inline-flex;align-items:center;justify-content:center}
  .note-cell{color:var(--muted);font-size:12.5px;min-width:160px;line-height:1.4;border-radius:6px;padding:6px 8px;cursor:text}
  .note-cell:hover{background:var(--bg)}
  .note-cell:focus{outline:2px solid var(--brand-soft);background:#fff;color:var(--ink)}
  .note-cell:empty::before{content:"Add note…";color:var(--line-strong)}
  .brow{cursor:pointer}
  .brow:hover td{background:#FAFCFC}
  .blegend{font-size:11px;color:var(--faint);margin-top:10px}

  /* ── Dashboard / Clients / Reports ───── */
  .page-scroll{flex:1;overflow-y:auto;min-height:0;padding:20px 24px 60px}
  .grid2{display:grid;grid-template-columns:1.5fr 1fr;gap:14px;align-items:start}
  .feed{list-style:none}
  .feed li{display:flex;gap:10px;padding:10px 16px;border-bottom:1px solid var(--line);font-size:12.5px;line-height:1.45}
  .feed li:last-child{border-bottom:none}
  .feed time{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;color:var(--faint);white-space:nowrap;padding-top:2px;width:62px;flex-shrink:0}
  .fdot{width:8px;height:8px;border-radius:50%;margin-top:5px;flex-shrink:0}
  .pills{display:flex;gap:6px;flex-wrap:wrap;padding:12px 16px}
  .pill{background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:5px 12px;font-size:12px;cursor:pointer}
  .pill b{margin-right:4px}
  .pill:hover{border-color:var(--brand)}
  .cardpad{padding:12px 16px;font-size:12.5px;color:var(--muted);line-height:1.5}
  .fresh{font-size:11px;font-weight:600;border-radius:5px;padding:2px 7px;display:inline-block;white-space:nowrap}
  .fr-ok{background:var(--green-soft);color:var(--green)}
  .fr-warn{background:var(--amber-soft);color:var(--amber)}
  .alertcell{font-size:11.5px;color:var(--amber);line-height:1.35}
  .alertcell.red{color:var(--red)}
  .cols{display:flex;align-items:flex-end;gap:10px;height:130px;padding:16px 16px 8px}
  .colu{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px;font-size:10.5px;color:var(--faint);height:100%}
  .colu i{display:block;width:100%;max-width:36px;background:var(--brand);border-radius:4px 4px 0 0}
  .colu b{color:var(--ink);font-size:11px}
  .hbars{padding:12px 16px}
  .hb{display:grid;grid-template-columns:170px 1fr 52px;gap:10px;align-items:center;margin:9px 0;font-size:12.5px}
  .hb .track{height:8px;background:var(--bg);border-radius:4px;overflow:hidden}
  .hb .track i{display:block;height:100%;background:var(--brand);border-radius:4px}
  .hb .val{font-weight:650;text-align:right;font-size:12px}
  .clickable{cursor:pointer}

  /* ── Toast ───────────────────────────── */
  #toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:#0F3A43;color:#fff;padding:11px 20px;border-radius:10px;font-size:13px;box-shadow:0 6px 24px rgba(15,58,67,.35);transition:transform .25s ease;z-index:50}
  #toast.show{transform:translateX(-50%) translateY(0)}

  .foot-note{position:fixed;bottom:8px;right:14px;font-size:10.5px;color:var(--faint);background:rgba(242,245,247,.85);padding:2px 8px;border-radius:6px;pointer-events:none}
</style>
</head>
<body>

<header>
  <div class="logo">
    <div class="logo-mark"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M1 4c2 0 2 2 4 2s2-2 4-2 2 2 4 2" fill="none" stroke="#0F3A43" stroke-width="1.6" stroke-linecap="round"/><path d="M1 8c2 0 2 2 4 2s2-2 4-2 2 2 4 2" fill="none" stroke="#0F3A43" stroke-width="1.6" stroke-linecap="round"/></svg></div>
    Yellow Harbour
  </div>
  <nav>
    <a href="#" id="nav-dash" onclick="showPage('dash');return false">Dashboard</a>
    <a href="#" id="nav-grants" class="active" onclick="showPage('grants');return false">Grants</a>
    <a href="#" id="nav-clients" onclick="showPage('clients');return false">Clients</a>
    <a href="#" id="nav-bible" onclick="showPage('bible');return false">Grant Bible</a>
    <a href="#" id="nav-reports" onclick="showPage('reports');return false">Reports</a>
  </nav>
  <div class="top-right">
    <span class="env-chip">Pilot</span>
    <div class="avatar" title="David McCarthy">DM</div>
  </div>
</header>

<div id="page-grants">
<div class="runbar">
  <div class="crumbs">Grants <span>/</span> <b>Community Resilience Fund 2026</b></div>
</div>

<div class="workspace">

  <!-- Grant context -->
  <aside class="grant-panel">
    <h2>Community Resilience Fund 2026</h2>
    <div class="funder">The Meadowbrook Foundation · new grant, first seen 23 Jul</div>
    <div class="grant-facts">
      <div class="fact"><div class="k">Amount</div><div class="v">€25k–€75k</div></div>
      <div class="fact"><div class="k">Deadline</div><div class="v">30 Sep 2026</div></div>
      <div class="fact"><div class="k">Duration</div><div class="v">≤ 24 months</div></div>
      <div class="fact"><div class="k">Co-funding</div><div class="v">20% required</div></div>
    </div>
    <div class="panel-h">Extracted criteria (8)</div>
    <ul class="crit-list">
      <li>Registered charity or CLG, ≥ 2 years operating</li>
      <li>Based in and serving the Republic of Ireland</li>
      <li>Project serves disadvantaged communities</li>
      <li>Priority: youth mental health &amp; wellbeing</li>
      <li>20% co-funding confirmed at application</li>
      <li>Audited accounts for the last 2 years</li>
      <li>Safeguarding policy where under-18s involved</li>
      <li>Measurable outcomes plan required</li>
