const BCHIPS = [
  {k:"all", label:()=>"All " + BIBLE.length},
  {k:"active", label:()=>"Active " + BIBLE.filter(r=>r.grp==="active"||r.grp==="action").length},
  {k:"action", label:()=>"Needs action " + BIBLE.filter(r=>r.grp==="action").length},
  {k:"submitted", label:()=>"Submitted " + BIBLE.filter(r=>r.grp==="submitted").length},
  {k:"outcome", label:()=>"Outcomes " + BIBLE.filter(r=>r.grp==="outcome").length}
];

function renderBChips(){
  document.getElementById("bchips").innerHTML = BCHIPS.map(c =>
    `<button class="chip ${state.bfilter===c.k?"active":""}" onclick="setBFilter('${c.k}')">${c.label()}</button>`).join("");
}

function bvisible(){
  return BIBLE.filter(r=>{
    if(state.bfilter==="active" && !(r.grp==="active"||r.grp==="action")) return false;
    if(["action","submitted","outcome"].includes(state.bfilter) && r.grp!==state.bfilter) return false;
    if(state.bq && !(r.fund+" "+r.funder+" "+r.clients).toLowerCase().includes(state.bq)) return false;
    return true;
  });
}

function renderBible(){
  document.getElementById("btable-body").innerHTML = bvisible().map(r => `
    <tr class="brow" onclick="bibleRow(${r.id})">
      <td class="fundcell">
        <b>${r.fund}</b>${r.auto?`<span class="autochip">⚡ auto</span>`:""}
        <div class="funder">${r.funder}</div>
        ${r.recur?`<div class="recur">${r.recur}</div>`:""}
      </td>
      <td style="font-weight:600;white-space:nowrap">${r.amount}</td>
      <td>
        <span style="font-weight:600;white-space:nowrap">${r.dl}</span>${r.left?`<span class="countd ${r.urg}">${r.left}</span>`:""}
        <div class="mssub">${r.ms}</div>
      </td>
      <td>
        <span class="stagechip st-${r.stKey}">${r.stage}</span>
        <div class="stagenote ${r.warn?"warn":""}">${r.note}</div>
      </td>
      <td style="font-size:12.5px">${r.clients}</td>
      <td>
        <span style="font-size:12px">${r.reqs.t}</span>
